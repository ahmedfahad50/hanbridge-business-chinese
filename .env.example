# Copy this file to .env.local and fill in real values as they become available.
# Nothing here is required for the site to run — every integration below is
# optional and only activates once its variable is set.

# The site's real production domain. Used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph metadata. Defaults to a placeholder domain.
NEXT_PUBLIC_SITE_URL=https://www.hanbridgebusinesschinese.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset to keep analytics fully disabled — no script loads without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe publishable key. Leave unset to keep /checkout in "request an
# invoice by email" mode instead of live card payment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
